{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(sf org display *)",
      "Bash(sf data query *)",
      "Bash(sf apex log list *)",
      "Bash(sf apex log get *)",
      "Bash(sf code-analyzer run *)",
      "Bash(sf apexguru scan *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(node .claude/skills/sf-deep-debugger/scripts/*.mjs*)",
      "Bash(node --test .claude/skills/sf-deep-debugger/tests/*.test.mjs*)"
    ],
    "deny": [
      "Bash(sf org delete *)",
      "Bash(sf data delete *)",
      "Bash(sf data create *)",
      "Bash(sf data update *)",
      "Bash(sf project delete *)",
      "Bash(sf apex run test *)",
      "Bash(sf apex test run *)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/skills/sf-deep-debugger/scripts/guard.mjs",
            "statusMessage": "sf-deep-debugger: checando mutação de org / escrita fora de docs/incidents"
          }
        ]
      }
    ]
  }
}
